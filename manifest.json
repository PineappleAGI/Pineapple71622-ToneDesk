{
  "manifest_version": 3,
  "name": "ToneDesk",
  "version": "2.4.0",
  "description": "Match tone, formality, and structure to the person you are writing to.",
  "permissions": [
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Open ToneDesk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/brand.svg"],
      "matches": [
        "https://mail.google.com/*",
        "https://*.linkedin.com/*",
        "https://web.whatsapp.com/*",
        "https://app.slack.com/*",
        "https://teams.microsoft.com/*"
      ]
    }
  ],
  "commands": {
    "rewrite-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Rewrite the selected text in ToneDesk"
    }
  }
}
